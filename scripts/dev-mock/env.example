# Environment for running `next dev` against scripts/dev-mock/server.mjs.
# Every value here is a dummy: none of it works against a real Supabase project or exchange.
#   set -a; . scripts/dev-mock/env.example; set +a; npx next dev
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=dev-mock-anon-key
SUPABASE_SERVICE_ROLE_KEY=dev-mock-service-role-key
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=dev-cron-secret
