# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Encryption key for private key storage (32-byte hex string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# App URL (for webhook URL display)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Required for the built-in strategy cron (/api/cron/strategy). Any long random string.
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Optional: Override Hyperliquid credentials via env (takes precedence over DB,
# and applies to EVERY user, so single-user deployments only).
# HL_PRIVATE_KEY=0x...      # API wallet key recommended
# HL_WALLET_ADDRESS=0x...   # main account address when the key is an API wallet
# HL_TESTNET=true           # forces testnet

# Optional: alerts for trades, strategy runs, errors, the kill switch, health and the daily summary.
# Telegram and email can both be set; each is used when its variables are present.
# Create a bot with @BotFather, then message it and read your chat id from getUpdates.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Email through Resend (resend.com, free tier). ALERT_EMAIL_FROM must be a sender Resend accepts for your account.
# RESEND_API_KEY=
# ALERT_EMAIL_TO=you@example.com
# ALERT_EMAIL_FROM=HL Trader <alerts@your-domain.com>

# Optional: WalletConnect QR pairing for the Wallet card (free project id from cloud.reown.com).
# Not needed when the site is opened inside a wallet's own browser (e.g. SafePal's DApp tab).
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
